# Rust build artifacts
/target
**/*.rs.bk

# Engine runtime data (lab volumes) — keep the directories, ignore contents
/data/work/*
/data/state/*
/data/input/*
/data/spool/*
!/data/**/.gitkeep

# SQLite state files
*.db
*.db-shm
*.db-wal

# Local env / secrets — never commit
.env
*.local

# Local AI assistant guidance (not part of the project)
/prompt/

# cargo-mutants output
mutants.out/
mutants.out.old/

# mkdocs build output (`mkdocs build` writes site/ by default)
/site/

# Python bytecode (mkdocs hooks import scripts/docs_hooks.py)
__pycache__/
*.pyc
