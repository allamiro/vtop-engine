  "configs": {
    "kafka_compose": "# Apache Kafka for the head-to-head comparison (#595, #596): three brokers in\n# KRaft mode, each a combined broker+controller, RF=3, min.insync.replicas=2.\n#\n# Fairness rule 1: every broker gets EXACTLY the limits each VTOP node gets in\n# compose.vtop.yml (2 CPUs, 2 GiB, no swap, a named volume on the same Docker\n# VM disk). Change one file, change the other; run.py records both in\n# environment.json and refuses to start when they differ.\n#\n# Everything else is Kafka as shipped (profile `defaults`, #595 rule 4): no\n# flush.messages, so a broker acknowledges on replication, not on fsync.\n#\n# The image is pinned by tag AND digest (rule 8); KAFKA_IMAGE overrides both.\nname: kc-kafka\n\nx-broker: &broker\n  image: ${KAFKA_IMAGE:-apache/kafka:4.3.2@sha256:852a0d49fc4e656b022e7f23785411802c9a088c78a7c5e39f33969de9c227a7}\n  cpus: 2\n  mem_limit: 2g\n  memswap_limit: 2g\n  ulimits:\n    nofile: { soft: 65536, hard: 65536 }\n  networks: [bench]\n  healthcheck:\n    test: [\"CMD-SHELL\", \"/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 > /dev/null 2>&1\"]\n    interval: 5s\n    timeout: 20s\n    retries: 30\n    start_period: 10s\n\nx-env: &env\n  # One fixed id: KRaft formats every log dir with it on first start.\n  CLUSTER_ID: \"a2NvbXBhcmUtcGhhc2UtMQ\"\n  KAFKA_PROCESS_ROLES: \"broker,controller\"\n  KAFKA_LISTENERS: \"PLAINTEXT://:9092,CONTROLLER://:9093\"\n  KAFKA_CONTROLLER_LISTENER_NAMES: \"CONTROLLER\"\n  KAFKA_INTER_BROKER_LISTENER_NAME: \"PLAINTEXT\"\n  KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: \"CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT\"\n  KAFKA_CONTROLLER_QUORUM_VOTERS: \"1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093\"\n  KAFKA_LOG_DIRS: \"/var/lib/kafka/data\"\n  # The replication contract (#595 rule 3).\n  KAFKA_DEFAULT_REPLICATION_FACTOR: \"3\"\n  KAFKA_MIN_INSYNC_REPLICAS: \"2\"\n  KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: \"3\"\n  KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: \"3\"\n  KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: \"2\"\n  # The benchmark topic is created explicitly by run.py with these settings;\n  # a typo'd topic must not be auto-created with others.\n  KAFKA_AUTO_CREATE_TOPICS_ENABLE: \"false\"\n\nservices:\n  kafka-1:\n    <<: *broker\n    hostname: kafka-1\n    environment:\n      <<: *env\n      KAFKA_NODE_ID: \"1\"\n      KAFKA_ADVERTISED_LISTENERS: \"PLAINTEXT://kafka-1:9092\"\n    volumes: [\"kafka-1-data:/var/lib/kafka/data\"]\n  kafka-2:\n    <<: *broker\n    hostname: kafka-2\n    environment:\n      <<: *env\n      KAFKA_NODE_ID: \"2\"\n      KAFKA_ADVERTISED_LISTENERS: \"PLAINTEXT://kafka-2:9092\"\n    volumes: [\"kafka-2-data:/var/lib/kafka/data\"]\n  kafka-3:\n    <<: *broker\n    hostname: kafka-3\n    environment:\n      <<: *env\n      KAFKA_NODE_ID: \"3\"\n      KAFKA_ADVERTISED_LISTENERS: \"PLAINTEXT://kafka-3:9092\"\n    volumes: [\"kafka-3-data:/var/lib/kafka/data\"]\n\nvolumes:\n  kafka-1-data:\n  kafka-2-data:\n  kafka-3-data:\n\nnetworks:\n  bench:\n    name: kc-kafka-bench\n",
    "vtop_compose": "# VTOP for the head-to-head comparison (#595, #596): three data nodes from the\n# image docker/Dockerfile builds, one range replicated to all three with a\n# write quorum of 2 of 3, and the Kafka gateway on the range's leader.\n#\n# Fairness rule 1: EXACTLY the per-node limits compose.kafka.yml gives each\n# Kafka broker (2 CPUs, 2 GiB, no swap, a named volume on the same Docker VM\n# disk). run.py records both in environment.json and refuses to start when\n# they differ.\n#\n# VTOP_IMAGE is set by run.py to the image it built from the commit under\n# test (vtop-bench:<sha>), so the recorded commit is the one that ran.\nname: kc-vtop\n\nx-node: &node\n  image: ${VTOP_IMAGE:?set VTOP_IMAGE to the vtop-bench image run.py built}\n  entrypoint: [\"vtop-node\", \"data\", \"--config\", \"/etc/vtop/node.yaml\"]\n  cpus: 2\n  mem_limit: 2g\n  memswap_limit: 2g\n  ulimits:\n    nofile: { soft: 65536, hard: 65536 }\n  networks: [bench]\n  healthcheck:\n    test: [\"CMD-SHELL\", \"curl -sf http://127.0.0.1:9600/readyz > /dev/null\"]\n    interval: 2s\n    timeout: 5s\n    retries: 60\n    start_period: 2s\n\nservices:\n  # Followers first: the leader's quorum needs them listening.\n  vtop-2:\n    <<: *node\n    hostname: vtop-2\n    volumes:\n      - \"./vtop/follower-1.yaml:/etc/vtop/node.yaml:ro\"\n      # Mounted at the image's home (owned by the unprivileged `vtop` user), so\n      # a fresh named volume inherits that ownership.\n      - \"vtop-2-data:/home/vtop\"\n  vtop-3:\n    <<: *node\n    hostname: vtop-3\n    volumes:\n      - \"./vtop/follower-2.yaml:/etc/vtop/node.yaml:ro\"\n      - \"vtop-3-data:/home/vtop\"\n  vtop-1:\n    <<: *node\n    hostname: vtop-1\n    depends_on:\n      vtop-2: { condition: service_healthy }\n      vtop-3: { condition: service_healthy }\n    volumes:\n      - \"./vtop/leader.yaml:/etc/vtop/node.yaml:ro\"\n      - \"vtop-1-data:/home/vtop\"\n\nvolumes:\n  vtop-1-data:\n  vtop-2-data:\n  vtop-3-data:\n\nnetworks:\n  bench:\n    name: kc-vtop-bench\n",
    "vtop_follower_1": "# VTOP node 2: a follower of the range led by vtop-1 (see leader.yaml).\n# Followers serve no Kafka gateway: the node refuses `kafka` on any role but\n# leader or standalone, because the gateway serves the range this node leads.\nrole: follower\nnode_uuid: aaaaaaaa-0000-0000-0000-0000000000a2\ncluster_id: 11111111-2222-3333-4444-555555555555\ndata_dir: /home/vtop/data\nfencing_epoch: 18\nrange: { topic: \"bench\", topic_epoch: 1, range_id: aaaaaaaa-0000-0000-0000-0000000000c1, range_generation: 0 }\nsegment_id: aaaaaaaa-0000-0000-0000-0000000000d1\nreplica_listen: \"0.0.0.0:9300\"\nreplica_transport: plaintext-on-any-interface\nobservability: { listen: \"0.0.0.0:9600\" }\n",
    "vtop_follower_2": "# VTOP node 3: a follower of the range led by vtop-1 (see leader.yaml).\nrole: follower\nnode_uuid: aaaaaaaa-0000-0000-0000-0000000000a3\ncluster_id: 11111111-2222-3333-4444-555555555555\ndata_dir: /home/vtop/data\nfencing_epoch: 18\nrange: { topic: \"bench\", topic_epoch: 1, range_id: aaaaaaaa-0000-0000-0000-0000000000c1, range_generation: 0 }\nsegment_id: aaaaaaaa-0000-0000-0000-0000000000d1\nreplica_listen: \"0.0.0.0:9300\"\nreplica_transport: plaintext-on-any-interface\nobservability: { listen: \"0.0.0.0:9600\" }\n",
    "vtop_leader": "# VTOP node 1: the range's static leader, with the Kafka gateway (#225).\n#\n# The shape scripts/live-chaos scenario 17 drives with a stock librdkafka\n# client (a static leader at a fixed fencing epoch, two followers, quorum\n# acknowledgement), moved into containers. Plaintext planes, as Kafka's\n# PLAINTEXT listeners on the other side, so neither system pays for TLS; the\n# `-on-any-interface` spelling is the node's own opt-in for leaving loopback.\n#\n# Every engine knob not written here is the binary's default (profile\n# `defaults`, #595 rule 4): the gateway appends with Durability::Quorum, which\n# acknowledges after a majority of the three replicas (leader included) has\n# made the append locally durable (fsync) \u2014 2 of 3, the write quorum the\n# comparison asks for. Kafka under `defaults` acknowledges on replication\n# without fsync; that difference is stated in the report, never hidden.\nrole: leader\nnode_uuid: aaaaaaaa-0000-0000-0000-0000000000a1\ncluster_id: 11111111-2222-3333-4444-555555555555\ndata_dir: /home/vtop/data\nfencing_epoch: 18\nrange: { topic: \"bench\", topic_epoch: 1, range_id: aaaaaaaa-0000-0000-0000-0000000000c1, range_generation: 0 }\nsegment_id: aaaaaaaa-0000-0000-0000-0000000000d1\nnative_listen: \"0.0.0.0:9400\"\nreplica_listen: \"0.0.0.0:9300\"\nfollowers:\n  - { node_uuid: aaaaaaaa-0000-0000-0000-0000000000a2, addr: \"vtop-2:9300\", server_name: \"vtop-2\" }\n  - { node_uuid: aaaaaaaa-0000-0000-0000-0000000000a3, addr: \"vtop-3:9300\", server_name: \"vtop-3\" }\nreplica_transport: plaintext-on-any-interface\nnative_transport: plaintext-on-any-interface\nprincipal_id: aaaaaaaa-0000-0000-0000-0000000000ce\nobservability: { listen: \"0.0.0.0:9600\" }\nkafka:\n  # Off loopback because the client runs in its own container; the gateway\n  # demands that be said by name (`any_interface`), and Metadata must name a\n  # host the client container resolves (`advertised_host`).\n  listen: \"0.0.0.0:9092\"\n  any_interface: true\n  advertised_host: \"vtop-1\"\n  advertised_port: 9092\n  topic: \"bench\"\n  node_id: 1\n"
  },
